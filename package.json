{
  "name": "liangwengu",
  "version": "0.1.1-rc.2",
  "description": "梁文谷 DSH 插件：在 Web GUI 右上角显示当前算力错峰时段（工作日 09:00–12:00 与 14:00–18:00 为梁文峰，其余时间含整个周末为梁文谷），并实时倒计时当前时段剩余时间；谷期跨天计算，直达下一工作日 09:00。适配 dsh-0.1.1-rc.2。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node test/time-slot.test.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@types/react": "18.3.24",
    "esbuild": "^0.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "time-slot",
    "off-peak",
    "liangwengu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VinciBeans/deepseek-plugin-liangwengu.git"
  },
  "homepage": "https://github.com/VinciBeans/deepseek-plugin-liangwengu#readme",
  "bugs": {
    "url": "https://github.com/VinciBeans/deepseek-plugin-liangwengu/issues"
  }
}
